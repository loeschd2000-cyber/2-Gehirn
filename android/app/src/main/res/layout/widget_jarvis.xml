<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <ImageView
        android:id="@+id/w_mic"
        android:layout_width="52dp" android:layout_height="52dp"
        android:background="@drawable/widget_mic_bg" android:padding="13dp"
        android:src="@drawable/ic_mic_dark" android:contentDescription="Jarvis zuhören lassen" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="6dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="JARVIS" android:textColor="#FF3FD6FF" android:textSize="12sp" android:letterSpacing="0.2" android:textStyle="bold" />
        <TextView android:id="@+id/w_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tippen und sprechen" android:textColor="#FFE6F6FF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/w_brief"
        android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center"
        android:background="@drawable/widget_chip_bg" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:text="☀️" android:textSize="16sp" android:contentDescription="Briefing" />
    <TextView android:id="@+id/w_diary"
        android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:layout_marginStart="6dp"
        android:background="@drawable/widget_chip_bg" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:text="📔" android:textSize="16sp" android:contentDescription="Tagebuch" />
</LinearLayout>
